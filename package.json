{
  "name": "opencode-filebrowser",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin: tabbed file browser, plain-text editor and binary viewer for the TUI",
  "license": "MIT",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "overrides": {
    "seroval": "1.6.8"
  },
  "scripts": {
    "compile": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='scripts/build.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "@opencode/theme": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@types/node": "26.6.5",
    "babel-preset-solid": "1.9.12",
    "typescript": "5.9.3"
  }
}
